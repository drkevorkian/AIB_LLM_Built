# Copy this file to .env and add your own keys locally. npm run dev / npm start load it.
# Keep .env private. Never commit it. Provider keys remain in the service process.
AIB_PORT=4317
# Optional: otherwise use the platform-specific application data directory.
# AIB_DATA_DIR=.data/local

# Set only the providers you plan to use, then restart the service.
OPENAI_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
# Optional authentication for an OpenAI-compatible server.
AIB_COMPATIBLE_API_KEY=

# Configure each participant's provider, exact model ID, and local/custom server URL in the app.
# Ollama uses http://127.0.0.1:11434 and requires a model already installed in Ollama.
# API usage is billed by the provider; website subscriptions/sessions are separate.
