{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eslint/no-eval": "error",
    "eslint/no-implied-eval": "error",
    "eslint/no-new-func": "error"
  },
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    ".data/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**"
  ]
}
